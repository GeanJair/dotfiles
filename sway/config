#Variaveis Globais
set $mod Mod4
set $DP1 DP-1
set $DP2 DP-2
set $left h
set $down j
set $up k
set $right l
set $term foot
set $files thunar
set $browser firefox
set $menu rofi -show drun

# Config dos monitores
output $DP1 resolution 1920x1080 position 0 0 render_bit_depth 10 adaptive_sync on
output $DP2 resolution 1920x1080 position 1920 0 render_bit_depth 10 transform 90

# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'

# Config do mouse e teclado
input type:pointer {
    accel_profile flat
	pointer_accel 0
}

input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
    xkb_options compose:caps
	repeat_delay 250
	repeat_rate 50
}

include ~/.config/sway/config.d/*
