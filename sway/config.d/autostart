exec systemctl --user set-environment \
    XDG_CURRENT_DESKTOP=sway \
    XDG_SESSION_DESKTOP=sway \
    XDG_SESSION_TYPE=wayland

exec systemctl --user import-environment \
    WAYLAND_DISPLAY \
    SWAYSOCK \
    DISPLAY

exec dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    SWAYSOCK \
    DISPLAY \
    XDG_CURRENT_DESKTOP=sway \
    XDG_SESSION_DESKTOP=sway \
    XDG_SESSION_TYPE=wayland

exec systemctl --user start sway-session.target
exec systemctl --user restart xdg-desktop-portal-wlr.service
exec systemctl --user restart xdg-desktop-portal.service

exec autotiling
exec blueman-applet
exec waybar
exec mako

exec mpvpaper -p -o 'no-audio loop' $DP1 ~/Pictures/Backgrounds/zelda.mp4
exec mpvpaper -p -o 'no-audio loop' $DP2 ~/Pictures/Backgrounds/street.mp4
